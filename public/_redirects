# A 200 rewrite, so the url stays /ot: the route takes its preset from the path
# (src/config/presets.ts). This replaces a second html shell, which lets
# `not_found_handling` be "404-page" (worker/wrangler.jsonc) at no Worker cost.
#
# Target "/", not "/index.html": `html_handling` answers "/index.html" with a 307 to "/",
# which would lose the preset.
#
# Static rules go above the splat rule: rules match in order, and wrangler warns that
# a static rule after a dynamic one cannot be matched as cheaply.
/ot / 200

# Old links to ot.html would get the 404 page, because src/router/index.ts never runs for them.
/ot.html /ot 301

# 301, not 302: /next is permanently at the apex. Browsers cache a 301 hard, so a
# revived /next preview will look broken to anyone who followed this once.
/next* /:splat 301
