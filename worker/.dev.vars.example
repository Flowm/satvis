# Copy to worker/.dev.vars (gitignored) for local `wrangler dev`.
#
# Bearer token for POST /api/refresh and POST /api/ingest; scripts/push-gp.mjs
# sends it as SATVIS_REFRESH_TOKEN. Unset disables both endpoints (503).
# In production it is a Worker secret:
#   pnpm --filter satvis-worker exec wrangler secret put REFRESH_TOKEN
REFRESH_TOKEN=local-dev-token
