{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satvis",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "send_metrics": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "satvis.space",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "../dist",
    // Not "single-page-application", which answers every missing file with index.html
    // and a 200. Without public/404.html a missing file becomes a billed Worker call.
    // Every app path must be a real html file or a public/_redirects rule (/ot).
    "not_found_handling": "404-page",
    // No file can shadow an api path. /__scheduled is wrangler dev's --test-scheduled endpoint.
    "run_worker_first": ["/api/*", "/__scheduled"],
  },
  "kv_namespaces": [{ "binding": "GP_KV", "id": "26a7848ab641416fa518a3df4790a968" }],
  "triggers": {
    // 6 h rather than 3 halves our share of CelesTrak's 250 MB/day per-IP budget, which
    // Cloudflare tenants share: ~7 MB a run is ~29 MB/day, for a few hundred metres of SGP4 drift.
    "crons": ["23 */6 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
