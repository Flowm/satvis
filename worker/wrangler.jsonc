{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satvis",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "send_metrics": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "satvis.space",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "../dist",
    // Not "single-page-application", which answers every missing file with index.html
    // and a 200. Without public/404.html a missing file becomes a billed Worker call.
    // Every app path must be a real html file or a public/_redirects rule (/ot).
    "not_found_handling": "404-page",
    // No file can shadow an api path. /__scheduled is wrangler dev's --test-scheduled endpoint.
    "run_worker_first": ["/api/*", "/__scheduled"],
  },
  "kv_namespaces": [{ "binding": "GP_KV", "id": "26a7848ab641416fa518a3df4790a968" }],
  "triggers": {
    // None: CelesTrak firewalls Cloudflare's egress, so a deployed cron gets HTTP 522
    // on every GP source and rewrites the index as failed. scripts/push-gp.mjs fills KV
    // instead, and the Docker image schedules its own refresh (scripts/serve.mjs).
    // Empty, not absent: without the key, a deploy leaves the old trigger in place.
    "crons": [],
  },
  "observability": {
    "enabled": true,
  },
}
