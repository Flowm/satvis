{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "mise",
      "runtimeArgs": ["exec", "--", "pnpm", "run", "dev"],
      "port": 5187,
      "autoPort": true
    },
    {
      "name": "preview",
      "runtimeExecutable": "mise",
      "runtimeArgs": ["exec", "--", "pnpm", "run", "preview"],
      "port": 5188,
      "autoPort": true
    },
    {
      // The real Worker against local KV, serving the built dist/ as assets.
      // Unlike `dev`/`preview` — whose /api proxy points at production — this
      // exercises the worker's own API, so run `pnpm build` first.
      "name": "worker",
      "runtimeExecutable": "mise",
      "runtimeArgs": ["exec", "--", "pnpm", "run", "dev:worker"],
      "port": 8080,
      "autoPort": false
    }
  ]
}
