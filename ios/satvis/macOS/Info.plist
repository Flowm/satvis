<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac's keys that have no build setting, or one that would leave the key
	     empty on iOS; the iPhone's are ../Info.plist. macOS asks for this location
	     purpose, not the "when in use" one. -->
	<key>NSLocationUsageDescription</key>
	<string>Your location lets Satvis tell you when satellites pass over you, and show what is in the sky above you.</string>
	<!-- From Config/Base.xcconfig: empty unless Config/Analytics.xcconfig, which git
	     ignores, sets them. -->
	<key>PostHogHost</key>
	<string>$(POSTHOG_HOST)</string>
	<key>PostHogProjectToken</key>
	<string>$(POSTHOG_PROJECT_TOKEN)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
