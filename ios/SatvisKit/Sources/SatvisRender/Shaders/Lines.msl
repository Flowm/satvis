// Each satellite's orbit and orbit track, drawn through its samples as a line one
// point wide in screen space, as the web app's PathGraphics and PolylineGeometry
// draw them: the orbit white at 15 %, half a period either side, fixed in
// inertial space and closed into a loop; the track gold at 15 %, a period ahead
// over the turning Earth.
// Its edges fade over a device pixel, where the web app smooths them with FXAA.

struct LineOut {
    float4 position [[position]];
    /// Device pixels from the middle of the line, signed.
    float across;
};

constant float earthRotationRate = 7.2921158553e-5;
constant int lineNodes = 121;
/// The orbit's nodes furthest behind the satellite that take up its drift, a
/// quarter of them, as SampledTrajectory.ts's DRIFT_RAMP_SHARE: one period on
/// the orbit has drifted (J2: 31 km for the ISS), so its two ends would miss.
/// Ahead of the satellite the line is its own path.
constant int driftRampNodes = (lineNodes - 1) / 4;

/// Sample `node` of a satellite, for a line of the given kind: an orbit node is
/// turned to where the Earth is now, so the line stays put in inertial space.
inline float3 lineNode(int node, int kind, float nowNode, PointInstance instance, const device packed_float3 *samples) {
    int k = clamp(node, 0, int(instance.sampleCount) - 1);
    float3 p = float3(samples[instance.sampleStart + uint(k)]);
    if (kind == 0) {
        float angle = earthRotationRate * (float(k) - nowNode) * instance.stepSeconds;
        float c = cos(angle), s = sin(angle);
        p = float3(c * p.x - s * p.y, s * p.x + c * p.y, p.z);
    }
    return p;
}

/// Whether the Earth stands between the eye and `p`, by a ray to a sphere a
/// little inside the ellipsoid, so a point just over the limb still shows.
inline bool behindEarth(float3 p, float3 eye) {
    float3 inverseRadii = 1.0 / ellipsoidRadii;
    RaySegment hit = raySphereIntersection(eye * inverseRadii, (p - eye) * inverseRadii, 0.999);
    return !isEmpty(hit) && hit.start > 0.0 && hit.start < 1.0;
}

/// Point `index` of a satellite's line, from the eye and in the fixed frame: its
/// samples, with where it is now between the one at or before the instant and
/// the next, as CesiumJS's path includes the current position. Without it the
/// line was a chord of samples 50 s apart, which passes 2 km under a low
/// satellite: off the screen, close up.
inline void linePoint(int index, int kind, int first, int current, float nowNode, PointInstance instance, const device packed_float3 *samples,
                      float3 drift, float3 satellite, float3 satelliteRelative, constant FrameUniforms &frame, thread float3 &position,
                      thread float3 &relative) {
    if (index == current - first + 1) {
        position = satellite;
        relative = satelliteRelative;
        return;
    }
    int node = first + index - (index > current - first ? 1 : 0);
    position = lineNode(node, kind, nowNode, instance, samples);
    if (kind == 0) {
        // The first node moved on by the drift is the last: the loop closes.
        position += drift * clamp(float(driftRampNodes - (node - first)) / float(driftRampNodes), 0.0, 1.0);
    }
    relative = (position - frame.cameraHigh) - frame.cameraLow;
}

/// Whether a point is beyond the near plane, which the reversed-Z projection puts
/// at w = z.
inline bool inFront(float4 clip) {
    return clip.w > clip.z;
}

/// Where the segment from `behind` to `front` crosses the near plane, just in front
/// of it: clip space is linear along the segment.
inline float4 nearCrossing(float4 behind, float4 front) {
    float w = behind.z * 1.001;
    return mix(behind, front, (w - behind.w) / (front.w - behind.w));
}

vertex LineOut lineVertex(uint vid [[vertex_id]], uint satellite [[instance_id]], const device packed_float3 *samples [[buffer(0)]],
                          constant FrameUniforms &frame [[buffer(1)]], const device PointInstance *instances [[buffer(2)]],
                          const device PointFrame *frames [[buffer(3)]], constant int &kind [[buffer(5)]]) {
    LineOut out;
    out.across = 0.0;
    PointInstance instance = instances[satellite];
    float3 now, nowRelative;
    if (!satellitePosition(satellite, samples, instances, frames, frame, now, nowRelative)) {
        out.position = float4(0.0, 0.0, -2.0, 1.0);
        return out;
    }
    // The stencil's third node is the one at or before the instant.
    PointFrame state = frames[satellite];
    float nowNode = float(state.stencilStart) + state.offset;
    int current = int(state.stencilStart) + 2;
    int first = current - (kind == 0 ? (lineNodes - 1) / 2 : 0);
    float3 drift = kind == 0 ? lineNode(first + lineNodes - 1, kind, nowNode, instance, samples) - lineNode(first, kind, nowNode, instance, samples) : float3(0.0);
    int index = int(vid / 2);
    float side = (vid & 1) ? 1.0 : -1.0;

    float3 here, before, after, hereRelative, beforeRelative, afterRelative;
    linePoint(index, kind, first, current, nowNode, instance, samples, drift, now, nowRelative, frame, here, hereRelative);
    linePoint(index - 1, kind, first, current, nowNode, instance, samples, drift, now, nowRelative, frame, before, beforeRelative);
    linePoint(index + 1, kind, first, current, nowNode, instance, samples, drift, now, nowRelative, frame, after, afterRelative);
    float4 clip = frame.viewProjection * float4(hereRelative, 1.0);
    float4 previous = frame.viewProjection * float4(beforeRelative, 1.0);
    float4 next = frame.viewProjection * float4(afterRelative, 1.0);
    // NaN is a node SGP4 refused (SampledTrajectory): the line stops there.
    if (any(isnan(clip)) || any(isnan(previous)) || any(isnan(next))) {
        out.position = float4(0.0, 0.0, -2.0, 1.0);
        return out;
    }
    // A segment through the near plane is cut where it crosses it: dropped, the
    // nodes either side of a satellite close up took its line with them, as one
    // is behind the eye.
    bool hereInFront = inFront(clip), previousInFront = inFront(previous), nextInFront = inFront(next);
    if (!hereInFront) {
        if (nextInFront && !previousInFront) {
            clip = nearCrossing(clip, next);
            previous = clip;
        } else if (previousInFront && !nextInFront) {
            clip = nearCrossing(clip, previous);
            next = clip;
        } else {
            out.position = float4(0.0, 0.0, -2.0, 1.0);
            return out;
        }
    } else {
        previous = previousInFront ? previous : nearCrossing(previous, clip);
        next = nextInFront ? next : nearCrossing(next, clip);
    }
    float2 toScreen = frame.viewportSize * 0.5;
    float2 direction = (next.xy / next.w - previous.xy / previous.w) * toScreen;
    direction = length(direction) > 0.0 ? normalize(direction) : float2(1.0, 0.0);
    float2 normal = float2(-direction.y, direction.x);
    // Half the point, and the half pixel its edge fades over beyond that.
    float halfWidth = 0.5 * frame.pixelScale + 0.5;
    // No width where this node and both its neighbours are behind the Earth: the
    // segments between such nodes have no area, and the GPU drops them before
    // sorting them into its tiles. The depth test discarded their pixels anyway,
    // but over 16,600 orbits the sorting took an iPad mini 57 ms of GPU a frame
    // to 33.
    if (behindEarth(here, frame.cameraPosition) && behindEarth(before, frame.cameraPosition) && behindEarth(after, frame.cameraPosition)) {
        halfWidth = 0.0;
    }
    clip.xy += normal * side * halfWidth / toScreen * clip.w;
    out.position = clip;
    out.across = side * halfWidth;
    return out;
}

fragment float4 lineFragment(LineOut in [[stage_in]], constant FrameUniforms &frame [[buffer(1)]], constant int &kind [[buffer(5)]]) {
    float coverage = clamp(0.5 * frame.pixelScale + 0.5 - abs(in.across), 0.0, 1.0);
    return float4(gammaCorrect(kind == 0 ? float3(1.0) : float3(1.0, 0.843, 0.0)), 0.15 * coverage);
}
