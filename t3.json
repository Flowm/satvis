{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Dev server",
      "command": "PORT=5187 mise exec -- pnpm run dev",
      "icon": "play",
      "previewUrl": "http://localhost:5187",
