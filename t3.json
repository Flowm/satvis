    },
    {
      "name": "Worker",
      "command": "mise exec -- pnpm run dev:worker",
      "icon": "debug",
      "previewUrl": "http://localhost:8787",
      "autoOpenPreview": true,
      "stopOnSettle": true
    }
  ]
}
